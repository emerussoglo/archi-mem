      "args": [
        "test"
      ],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "eslint",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "lint"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
