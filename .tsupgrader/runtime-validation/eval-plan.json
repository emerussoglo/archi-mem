      "kind": "process",
      "command": "npx",
      "args": [
        "tsc",
        "--noEmit"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "next-production-build",
      "kind": "process",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "verificationMethod": "exit-code",
